# Runtime (read by packages/common/settings.py)
# ISSUESENSE_ENV: development | test | production
ISSUESENSE_ENV=development
ISSUESENSE_LOG_LEVEL=INFO
# Use 0.0.0.0 only inside a container; 127.0.0.1 keeps a local server off the network.
ISSUESENSE_API_HOST=127.0.0.1
ISSUESENSE_API_PORT=8000
# JSON list of API key entries (hashes only). Create one with:
#   issuesense-create-key --user-id you --scope jira:read:ATLAS
ISSUESENSE_API_KEYS=[]

# Jira demo workspace (never your real one). The API token needs read access; the seed script
# (issuesense-seed-jira) also needs write access to create the demo issues.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Atlassian's official Rovo MCP server (API-token auth must be enabled by the site admin).
ISSUESENSE_JIRA_MCP_URL=https://mcp.atlassian.com/v2/mcp
# Projects searched when a question names none.
ISSUESENSE_JIRA_PROJECTS=["ATLAS"]
# Calls to MCP servers: per-attempt timeout, attempts (1 = no retry), pause before a retry, and
# the cut-off for one whole retrieval (a search plus each issue's comments and history).
ISSUESENSE_MCP_CALL_TIMEOUT_SECONDS=20
ISSUESENSE_MCP_CALL_ATTEMPTS=2
ISSUESENSE_MCP_RETRY_BACKOFF_SECONDS=0.5
ISSUESENSE_RETRIEVAL_TIMEOUT_SECONDS=60

# LLM provider for query planning and written answers. Empty = rule-based planning, and answers
# quote the evidence directly (no LLM). Supported: nvidia_nim (NVIDIA NIM, OpenAI-compatible API).
# LLM_MODEL is the model id from build.nvidia.com (for example a Llama or Nemotron instruct model);
# LLM_API_KEY is your nvapi-... key. LLM_BASE_URL defaults to https://integrate.api.nvidia.com/v1.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
ISSUESENSE_LLM_TIMEOUT_SECONDS=60

# Everything below is not read yet; each block is wired up by the phase that introduces it.

NOTION_TOKEN=
# Gmail uses OAuth; its settings are defined in Phase 3.2.

# Persistence (introduced in Phase 4)
DATABASE_URL=postgresql+psycopg://issuesense:issuesense@localhost:5432/issuesense

# Optional observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=issuesense
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
