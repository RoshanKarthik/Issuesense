# Runtime
ISSUESENSE_ENV=development
ISSUESENSE_LOG_LEVEL=INFO
ISSUESENSE_API_HOST=0.0.0.0
ISSUESENSE_API_PORT=8000

# Provider routing (provider adapters are configuration-driven)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Source connectors. Only GitHub is required for Phase 1.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
NOTION_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
GOOGLE_MCP_ENDPOINT=

# Persistence (introduced in Phase 6)
DATABASE_URL=postgresql+psycopg://issuesense:issuesense@localhost:5432/issuesense

# Optional observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=issuesense
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

